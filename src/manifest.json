{
  "manifest_version": 3,
  "name": "Doshisha Autofill",
  "version": "1.0.1",
  "minimum_chrome_version": "150",
  "browser_specific_settings": {
    "gecko": {
      "id": "doshisha-autofill@tadashin.me",
      "strict_min_version": "150.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "description": "doshisha.ex-tic.com のログインや認証を自動化します。※本拡張機能は非公式であり、同志社大学とは関係ありません。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Doshisha Autofill"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "commands": {
    "open-login-page": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "同志社ログイン画面を開く"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://doshisha.ex-tic.com/auth/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
